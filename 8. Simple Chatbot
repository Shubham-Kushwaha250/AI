import re

rules = {
    r'\b(hi|hello|hey)\b': "Hello! How can I help you today?",
    r'\bwhat is your name\b': "I am an AI assistant chatbot.",
    r'\bhow are you\b': "I'm just a Python script, but I'm doing great!",
    r'\b(bye|exit|quit)\b': "Goodbye! Have a great day!"
}

def chatbot_response(user_input):
    for pattern, response in rules.items():
        if re.search(pattern, user_input.lower()):
            return response

    return "I'm sorry, I don't understand that."

print("Chatbot initialized! Type 'exit' or 'bye' to stop.\n")

while True:
    user_text = input("You: ")
    response = chatbot_response(user_text)
    print(f"Bot: {response}\n")

    if re.search(r'\b(bye|exit|quit)\b', user_text.lower()):
        break
