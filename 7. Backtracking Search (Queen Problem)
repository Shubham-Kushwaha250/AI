def is_safe(board, row, col):
    for i in range(row):
        if board[i] == col or \
           board[i] - i == col - row or \
           board[i] + i == col + row:
            return False
    return True

def solve_nqueens(board, row):
    if row == 8:
        return True
        
    for col in range(8):
        if is_safe(board, row, col):
            board[row] = col
            if solve_nqueens(board, row + 1):
                return True
            board[row] = -1 
            
    return False

board = [-1] * 8
solve_nqueens(board, 0)

print("8-Queens Column positions for each row:")
print(board)
print("\nBoard Representation (1 = Queen, . = Empty):")
for col in board:
    row_str = ['.'] * 8
    row_str[col] = '1'
    print(" ".join(row_str))
